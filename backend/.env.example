# URL local de Ollama (motor de modelos locales)
OLLAMA_HOST=http://localhost:11434

# Modelo usado para generar embeddings (RAG)
EMBED_MODEL=nomic-embed-text

# Ruta de la base de datos SQLite
DATABASE_URL=sqlite:///./data/playground.db

# Origen permitido para el frontend (CORS) en desarrollo
CORS_ORIGIN=http://localhost:5173

# Clave para firmar los tokens de sesion (cambiar en cualquier entorno compartido)
SECRET_KEY=cambia-esta-clave
TOKEN_TTL_HOURS=12

# Siembra 30 dias de historial de uso en una base nueva
SEED_DEMO_ACTIVITY=true
