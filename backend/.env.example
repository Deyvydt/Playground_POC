# URL local de Ollama (motor de modelos locales)
OLLAMA_HOST=http://localhost:11434

# Modelo usado para generar embeddings (RAG)
# (ej. gte-large si no se puede descargar nomic-embed-text)
EMBED_MODEL=nomic-embed-text

# Ruta de la base de datos SQLite
DATABASE_URL=sqlite:///./data/playground.db

# Origen permitido para el frontend (CORS) en desarrollo
CORS_ORIGIN=http://localhost:5173

# Clave para firmar los tokens de sesion (cambiar en cualquier entorno compartido)
SECRET_KEY=cambia-esta-clave
TOKEN_TTL_HOURS=12

# Siembra 30 dias de historial de uso en una base nueva
SEED_DEMO_ACTIVITY=true

# Modelo de chat por defecto para agentes nuevos y de ejemplo
DEFAULT_CHAT_MODEL=llama3.2:3b

# --- Gobierno de LLMs (opcional) ---
# Si se define, los agentes llaman al modelo via el gateway (services/gateway) en vez de a
# Ollama directo. Sin esta variable el camino directo sigue funcionando igual (Principio I).
# LLM_GATEWAY_URL=http://127.0.0.1:4000
# GOVERNANCE_URL=http://127.0.0.1:8100
# Mismo valor que SERVICE_TOKEN en services/governance/.env
# SERVICE_TOKEN=cambia-este-token
# Cifra la virtual key de cada agente en la base del backend.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GATEWAY_FERNET_KEY=cambia-esta-clave
