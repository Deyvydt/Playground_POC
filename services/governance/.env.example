# Copiar a .env y completar. .env nunca se versiona.

# Base propia del servicio (Postgres local de services/gateway/start_db.py)
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/governance

# Gateway: URL interna, clave de administrador y URL que verán los clientes
GATEWAY_URL=http://127.0.0.1:4000
GATEWAY_PUBLIC_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-copiar-de-services-gateway-env

# Servicio de identidad (backend de TokenIO): valida las sesiones de los usuarios
IDENTITY_URL=http://127.0.0.1:8000

# Token para llamadas entre servicios (agent-lab, backend) y para el webhook del gateway
SERVICE_TOKEN=cambia-este-token
WEBHOOK_TOKEN=cambia-este-token

# Monitor de auto-pausa
MONITOR_INTERVAL_SECONDS=60
BUDGET_WARNING_RATIO=0.8
ERROR_RATE_THRESHOLD=0.5
ERROR_WINDOW_MINUTES=10
ERROR_MIN_CALLS=5

CORS_ORIGIN=http://localhost:5173
