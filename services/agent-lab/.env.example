# Copiar a .env y completar. .env nunca se versiona.

# Base propia del servicio (Postgres local de services/gateway/start_db.py)
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/agentlab

# Gateway: los nodos llaman directo con su propia virtual key (sin master key)
GATEWAY_URL=http://127.0.0.1:4000

# Governance: para registrar los 8 agentes de prueba (provision.py) y validar sesiones
GOVERNANCE_URL=http://127.0.0.1:8100

# Servicio de identidad (backend de TokenIO): valida las sesiones de los usuarios
IDENTITY_URL=http://127.0.0.1:8000

# Mismo valor que SERVICE_TOKEN en services/governance/.env
SERVICE_TOKEN=cambia-este-token

# Clave Fernet para cifrar las keys de los nodos en la base de agent-lab.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LAB_FERNET_KEY=cambia-esta-clave

CORS_ORIGIN=http://localhost:5173
