# Copiar a .env y completar. .env nunca se versiona.

# Clave de administrador del gateway (debe empezar con sk-). Solo la usan governance y los scripts.
LITELLM_MASTER_KEY=sk-cambia-esta-clave
# Cifra las credenciales que LiteLLM guarda en la base. No cambiarla después de crear keys.
LITELLM_SALT_KEY=sk-cambia-esta-sal

# Postgres local (ver start_db.py)
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/litellm

# Motor de modelos locales
OLLAMA_API_BASE=http://localhost:11434

# Puerto y host del gateway (0.0.0.0 para exponerlo en la red local)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000

# API keys reales de proveedores (cuando se usen)
# ANTHROPIC_API_KEY_1=
# ANTHROPIC_API_KEY_2=
# OPENAI_API_KEY_1=

# Alertas de presupuesto -> governance (WEBHOOK_TOKEN de services/governance/.env)
WEBHOOK_URL=http://127.0.0.1:8100/gov/alerts/gateway?token=cambia-este-token
